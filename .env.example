# Copy to .env (never commit .env). All settings are optional.

# Where the database lives. Default: file:~/.keel/keel.db
# v2 (hosted): libsql://<your-db>.turso.io
KEEL_DB_URL=

# Only needed for a hosted libSQL / Turso database (v2).
KEEL_DB_TOKEN=

# Force the CLI palette: light | dark. Default: detect from the terminal.
KEEL_THEME=

# Port for `keel serve` (always bound to 127.0.0.1). Default: 4242
KEEL_PORT=
