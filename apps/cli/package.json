{
  "name": "@nouisi/keel",
  "version": "0.3.1",
  "description": "Keep your promises, priorities and project context in one terminal. CLI plus a browser terminal, local-first.",
  "type": "module",
  "license": "MIT",
  "author": "Prakash Upadhyay",
  "homepage": "https://nouisi-keel.mintlify.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upadhyayprakash/keel.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/upadhyayprakash/keel/issues",
  "keywords": ["cli", "terminal", "productivity", "commitments", "todo", "context-switching", "local-first", "sqlite", "libsql"],
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "keel": "./dist/keel.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@libsql/client": "^0.15.0",
    "chrono-node": "^2.8.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.10.0",
    "ulidx": "^2.4.0"
  },
  "devDependencies": {
    "@keel/core": "workspace:*",
    "@keel/server": "workspace:*",
    "tsup": "^8.5.0",
    "vitest": "^3.2.0"
  }
}
